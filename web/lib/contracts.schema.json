    "Artifact": {
      "additionalProperties": false,
      "description": "Heavy visual payload attached to a candidate (kept out of the event log).\n\nStored as JSON at `<campaign_dir>/artifacts/<id>.json`; events carry only\nthis descriptor. Payload shapes by kind:\n  relaxation_trajectory: {symbols[], cell[3][3]|null, pbc, frames[[x,y,z]...], energies[]}\n  neb_path:              {symbols[], cell, frames[...], energies[], mobile_index, barrier_ev}\n  void_grid:             {cell, shape[3], values[] (flat, 0..1), void_fraction, pore_diameter_A}\n  adsorption_sites:      {symbols[], cell, positions[], guests[{symbols[],positions[],energy_ev}]}\n  crystal_packing:       {symbols[], cell, positions[], molecules[[atom indices]]}\n  orbital:               {symbols[], positions[], grid{origin,axes,shape,values[]}, which}",
      "properties": {
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "relaxation_trajectory",
            "neb_path",
            "void_grid",
            "adsorption_sites",
            "crystal_packing",
            "orbital"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "id",
        "candidate_id",
        "kind",
        "label",
        "uri"
      ],
      "title": "Artifact",
      "type": "object"
    },
